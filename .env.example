# Copy to .env and fill in.  The token comes from @BotFather.
TELEGRAM_BOT_TOKEN=

# Search budget per request.  The bot stops at whichever runs out first and
# says so rather than pretending the deal is unsolvable.
SHENZHEN_MAX_NODES=400000
SHENZHEN_TIME_LIMIT=20

# How many positions may be solved at once.  Each one pins a CPU core.
SHENZHEN_WORKERS=2

LOG_LEVEL=INFO

# Measure which code the running bot actually reaches, into this directory.
# Left empty the bot runs unmeasured, which is the normal state; turn it on for
# a week when you want to know what real traffic never touches.  Slows the
# solver by roughly a fifth.  See docs/coverage.md.
SHENZHEN_COVERAGE=

